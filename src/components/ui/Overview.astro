---
// Asset imports
import SunSvg from "@svg/icon-sun.svg";
import MoonSvg from "@svg/icon-moon.svg";

// Component imports
import Button from "@components/ui/Button.astro";

// Type imports
import type { HTMLAttributes } from "astro/types";
import type { TimeState } from "@/lib/deriveTimeState";

// Props
interface Props extends HTMLAttributes<"section"> {
  timeState: TimeState;
}

const { timeState } = Astro.props;

const date = new Date(timeState.timestamp);
---

<section id="overview-section" aria-label="Current local time">
  <div class="content flow-xl">
    <!-- Headline -->
    <div class="headline">
      <div class="icon" data-theme={timeState.dayTime}>
        <SunSvg class="sun" aria-hidden="true" />
        <MoonSvg class="moon" aria-hidden="true" />
      </div>
      <p class="text">
        <span class="greeting">Good {timeState.greeting}</span><span
          >, it's currently</span
        >
      </p>
    </div>

    <!-- Time -->
    <div class="time-container">
      <time class="time" datetime={date.toISOString()}
        >{
          date.toLocaleTimeString(undefined, {
            hour: "numeric",
            minute: "numeric",
            hour12: false,
          })
        }</time
      >
      <span class="timezone">{timeState.timezoneShort}</span>
    </div>

    <!-- Location -->
    <p class="location">in {timeState.city}, {timeState.continent}</p>
  </div>

  <!-- Expand button -->
  <Button
    text="more"
    icon
    aria-controls="details-section"
    aria-expanded="false"
  />
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  // Section
  section {
    display: grid;
    gap: var(--space-cont-2xl);
    align-items: end;

    @include mq(large) {
      grid-template-columns: 1fr auto;
    }
  }

  //   Headline
  .headline {
    display: flex;
    gap: var(--space-cont-sm);
    align-items: center;

    .icon {
      svg {
        width: var(--size-svg-theme);
      }

      &[data-theme="day"] {
        .moon {
          display: none;
        }
      }

      &[data-theme="night"] {
        .sun {
          display: none;
        }
      }
    }

    .text {
      font: var(--font-5);
      letter-spacing: var(--ls-5);
      text-transform: uppercase;

      span:last-child {
        display: none;

        @include mq(medium) {
          display: inline;
        }
      }
    }
  }

  //   Time
  .time-container {
    .time {
      font: var(--font-1);
      letter-spacing: var(--ls-1);
    }

    .timezone {
      font: var(--font-3);
      letter-spacing: var(--ls-3);
    }
  }

  //   Location
  .location {
    font: var(--font-4);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
  }
</style>
