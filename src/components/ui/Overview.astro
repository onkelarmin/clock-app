---
// Asset imports
import SunSvg from "@svg/icon-sun.svg";
import MoonSvg from "@svg/icon-moon.svg";

// Component imports
import Button from "@components/ui/Button.astro";
---

<section id="overview-section" aria-label="Current local time">
  <div class="content flow-xl">
    <!-- Headline -->
    <div class="headline">
      <div class="icon" data-theme="night">
        <SunSvg class="sun" aria-hidden="true" />
        <MoonSvg class="moon" aria-hidden="true" />
      </div>
      <p class="text">
        <span class="greeting">Good morning</span><span>, it's currently</span>
      </p>
    </div>

    <!-- Time -->
    <div class="time-container">
      <time class="time" datetime="2026-02-03T09:14">09:14</time>
      <span class="timezone">BST</span>
    </div>

    <!-- Location -->
    <p class="location">in London, UK</p>
  </div>

  <!-- Expand button -->
  <Button
    text="more"
    icon
    aria-controls="details-section"
    aria-expanded="false"
  />
</section>

<style lang="scss">
  @use "@sass/miscellaneous" as *;

  // Section
  section {
    display: grid;
    gap: var(--space-cont-2xl);
    align-items: end;

    @include mq(large) {
      grid-template-columns: 1fr auto;
    }
  }

  //   Headline
  .headline {
    display: flex;
    gap: var(--space-cont-sm);
    align-items: center;

    .icon {
      svg {
        width: var(--size-svg-theme);
      }

      &[data-theme="day"] {
        .moon {
          display: none;
        }
      }

      &[data-theme="night"] {
        .sun {
          display: none;
        }
      }
    }

    .text {
      font: var(--font-5);
      letter-spacing: var(--ls-5);
      text-transform: uppercase;

      span:last-child {
        display: none;

        @include mq(medium) {
          display: inline;
        }
      }
    }
  }

  //   Time
  .time-container {
    .time {
      font: var(--font-1);
      letter-spacing: var(--ls-1);
    }

    .timezone {
      font: var(--font-3);
      letter-spacing: var(--ls-3);
    }
  }

  //   Location
  .location {
    font: var(--font-4);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
  }
</style>
