---
// Asset imports
import Icon from "@svg/icon-arrow.svg";

// Types
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  type?: "button" | "submit";
  text?: string;
  icon?: boolean;
  classes?: string;
}

const { type = "button", text, icon = false, classes, ...rest } = Astro.props;
---

<button class:list={["btn", classes]} {type} {...rest}>
  {text && <span class="text">{text}</span>}
  {
    icon && (
      <span class="icon">
        {" "}
        <Icon />
      </span>
    )
  }
</button>

<style lang="scss">
  .btn {
    width: fit-content;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--btn-gap-default);
    font: var(--font-8);
    letter-spacing: var(--ls-8);
    background-color: var(--btn-bg-color-idle-default);
    color: var(--btn-fg-color-idle-default);
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    border-radius: var(--btn-border-radius-default);
    padding-inline-start: var(--btn-padding-inline-start-default);
    padding-inline-end: var(--btn-padding-inline-end-default);
    padding-block: var(--btn-padding-block-default);

    // Icon
    .icon {
      display: grid;
      place-items: center;
      width: var(--btn-icon-container-width-default);
      aspect-ratio: 1;
      border-radius: var(--br-round);
      background-color: var(--btn-icon-bg-color-idle-default);
      transition:
        background-color var(--trans-default),
        transform var(--trans-default-sensitive);

      svg {
        width: var(--btn-icon-width-default);
      }
    }

    &[aria-expanded="true"] {
      .icon {
        transform: rotate(180deg);
      }
    }

    &:not(:disabled) {
      cursor: pointer;
    }

    &:focus {
      outline: 0px solid transparent;
    }

    @media (hover: hover) {
      &:hover {
        .icon {
          background-color: var(--btn-icon-bg-color-hover-default);
        }
      }
    }

    &:focus-visible {
      box-shadow:
        0 0 0 var(--btn-offset-width-default)
          var(--btn-offset-color-focus-default),
        0 0 0
          calc(
            var(--btn-offset-width-default) + var(--btn-outline-width-default)
          )
          var(--btn-outline-color-focus-default);
    }
  }
</style>
