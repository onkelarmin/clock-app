---
// Import Site data
import { sitePages } from "@/data/siteData";

// Layout import
import MainLayout from "@layouts/MainLayout.astro";

// Component imports
import Quote from "@/components/ui/Quote.astro";
import Overview from "@/components/ui/Overview.astro";

const page = sitePages.home;
---

<MainLayout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
>
  <div class="layout">
    <h1 class="visually-hidden">Local Time Clock and Date information</h1>
    <Quote />
    <Overview />
  </div>
</MainLayout>
