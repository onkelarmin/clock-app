---
// Integrations
import { actions } from "astro:actions";

// Import Site data
import { sitePages } from "@/data/siteData";

// Layout import
import MainLayout from "@layouts/MainLayout.astro";

// Component imports
import Wrapper from "@/components/utilities/Wrapper.astro";
import Quote from "@/components/ui/Quote.astro";
import Overview from "@/components/ui/Overview.astro";
import Details from "@/components/ui/Details.astro";

// Helper functions
import { deriveTimeState } from "@/lib/deriveTimeState";

const { data } = await Astro.callAction(actions.getTime, undefined);

const timeState = deriveTimeState(data);

const page = sitePages.home;
---

<MainLayout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
  timeState={timeState}
>
  <Wrapper>
    <div class="layout">
      <h1 class="visually-hidden">Local Time Clock and Date information</h1>
      <Quote />
      <Overview timeState={timeState} />
    </div>
  </Wrapper>
  <Details timeState={timeState} />

  <!-- Pass initial timeState -->
  <script
    id="time-state"
    type="application/json"
    set:html={JSON.stringify(timeState)}
  />
</MainLayout>

<style lang="scss">
  .layout {
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block-start: var(--pad-page-inline-start);
    padding-block-end: var(--pad-page-inline-end);
  }
</style>
